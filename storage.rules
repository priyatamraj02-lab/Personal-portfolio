rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUnderLimit(maxSizeMb) {
      return request.resource.size < maxSizeMb * 1024 * 1024;
    }

    // Public can read uploaded media (thumbnails, screenshots, resumes)
    match /{allPaths=**} {
      allow read: if true;
    }

    // Authenticated admin can upload profile images (under 10MB)
    match /profile/{fileName} {
      allow write: if isAuthenticated() && isUnderLimit(10);
    }

    // Authenticated admin can upload project thumbnails & screenshots (under 15MB)
    match /projects/{fileName} {
      allow write: if isAuthenticated() && isUnderLimit(15);
    }

    // Authenticated admin can upload portfolio media (under 15MB)
    match /portfolio/{fileName} {
      allow write: if isAuthenticated() && isUnderLimit(15);
    }

    // Authenticated admin can upload certification images (under 10MB)
    match /certificates/{fileName} {
      allow write: if isAuthenticated() && isUnderLimit(10);
    }

    // Authenticated admin can upload achievement images (under 10MB)
    match /achievements/{fileName} {
      allow write: if isAuthenticated() && isUnderLimit(10);
    }

    // Authenticated admin can upload resume PDF (under 15MB)
    match /resume/{fileName} {
      allow write: if isAuthenticated() && isUnderLimit(15);
    }

    // General uploads folder
    match /uploads/{fileName} {
      allow write: if isAuthenticated() && isUnderLimit(15);
    }
  }
}

